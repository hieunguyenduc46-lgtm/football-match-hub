# ===== Football Match Hub - Backend config =====
# Copy this file to ".env" and fill in the real values.

# Get a key at https://www.api-football.com/  (sign up -> Dashboard -> API key)
# If left empty, the backend runs in MOCK mode (sample data).
API_FOOTBALL_KEY=

# How the key was registered:
#   direct   = registered directly on the api-sports.io dashboard (header x-apisports-key)
#   rapidapi = registered via RapidAPI (header x-rapidapi-key)
API_FOOTBALL_VIA=direct

# Host when using "direct"
API_FOOTBALL_HOST=v3.football.api-sports.io

# Season to fetch. NOTE: the free plan usually does NOT include the current season;
# if results are empty, try an older season (e.g. 2023) that your plan covers.
SEASON=2025

# true = use sample data, no real API calls (handy for trying it out without a key)
USE_MOCK=true

# Frontend origin(s). When deploying, add the real domain, comma-separated:
# e.g. http://localhost:5173,https://football-match-hub.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Cache time per response (seconds). Helps stay under the free limit of 100 req/day.
CACHE_TTL_SECONDS=300

# Enable the /_debug/* endpoints (raw API output). DEFAULT false in production.
# Only set true when running locally to debug.
DEBUG=false
