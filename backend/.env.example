# ===== Football Match Hub - Backend config =====
# Copy file này thành ".env" rồi điền giá trị thật.

# Lấy key tại https://www.api-football.com/  (đăng ký tài khoản -> Dashboard -> API key)
# Nếu để trống, backend tự chạy ở chế độ MOCK (dữ liệu mẫu).
API_FOOTBALL_KEY=

# Cách đăng ký key:
#   direct   = đăng ký trực tiếp dashboard api-sports.io (header x-apisports-key)
#   rapidapi = đăng ký qua RapidAPI (header x-rapidapi-key)
API_FOOTBALL_VIA=direct

# Host khi dùng "direct"
API_FOOTBALL_HOST=v3.football.api-sports.io

# Mùa giải muốn lấy. LƯU Ý: gói free thường KHÔNG có mùa hiện tại,
# nếu rỗng thì thử mùa cũ hơn (vd 2023) mà gói của bạn có.
SEASON=2025

# true = dùng dữ liệu mẫu, không gọi API thật (tiện chạy thử khi chưa có key)
USE_MOCK=true

# Origin của frontend. Khi deploy, thêm domain thật, cách nhau dấu phẩy:
# vd: http://localhost:5173,https://football-match-hub.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Thời gian cache mỗi response (giây). Giúp không vượt giới hạn free 100 req/ngày.
CACHE_TTL_SECONDS=300

# Bật endpoint /_debug/* (xem nguyên văn API). MẶC ĐỊNH false ở production.
# Chỉ đặt true khi chạy local để chẩn lỗi.
DEBUG=false
